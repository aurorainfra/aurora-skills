{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5": { "name": "GPT-5" }
      }
    },
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic",
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-sonnet-5": { "name": "Claude Sonnet 5" }
      }
    },
    "aurora": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Aurora Inference",
      "options": {
        "baseURL": "https://ai.aur.lu/v1",
        "apiKey": "{env:AURORA_API_KEY}"
      },
      "models": {
        "deepseek/deepseek-v4-flash": { "name": "Aurora DeepSeek V4 Flash" }
      }
    }
  }
}
