# Aurora inference credentials.
# Generate a key at https://portal.aur.lu (prod) or https://dashboard.dev.aur.lu (dev).
# Keys are ENVIRONMENT-SCOPED: a dev key 401s against prod and vice versa.
AURORA_API_KEY=your_key_here

# OpenAI-compatible base URL. Prod default below; dev is https://inference.dev.aur.lu/v1
AURORA_API_ENDPOINT=https://ai.aur.lu/v1
